{
  "lock": false,
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "start": "PORT=8004 deno run -A --watch=static/,routes/ dev.ts",
    "dev": "PORT=8004 deno run -A --watch=static/,routes/ dev.ts",
    "api": "deno run -A --watch local-api/server.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno run -A main.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update .",
    "test": "deno test --allow-net --allow-env --allow-read"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".playwright-mcp/"
  ],
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "tailwindcss/": "npm:/tailwindcss@3.4.1/",
    "qr-code-styling": "https://esm.sh/qr-code-styling@1.9.2?target=es2022",
    "jszip": "https://esm.sh/jszip@3.10.1?target=es2022",
    "jsqr": "https://esm.sh/jsqr@1.4.0?target=es2022",
    "qrcode-generator": "https://esm.sh/qrcode-generator@1.5.0?target=es2022",
    "zxing-wasm/reader": "https://esm.sh/zxing-wasm@2.1.2/reader?target=es2022",
    "$std/": "https://deno.land/std@0.216.0/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "deploy": {
    "org": "pibulus",
    "app": "qrbuddy",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "main.ts"
    },
    "//": "`runtime` is REQUIRED unless `framework` is set. Without it, Deploy auto-detects Fresh and runs a bundle step this app does not want \u2014 that is what broke every git-triggered build on promapper while CLI deploys kept reporting success. To skip the build, OMIT the `build` key. Never set it to \"\": the CLI path reads that as 'skip', the git path executes it and dies with \"Error parsing script '': Empty command\". Verified 2026-07-31."
  }
}
